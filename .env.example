# Copy to .env and fill in. NEVER commit .env.

# Claude (used by ORION, LUNA, NOVA). Leave blank to run those agents in rules-only mode.
ANTHROPIC_API_KEY=

# Tradovate API credentials (from Tradovate > Settings > API Access)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=tradebot
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=

# Live trading arm switch. Live orders are refused unless this is exactly:
#   TRADEBOT_LIVE_ARMED=yes-real-money
TRADEBOT_LIVE_ARMED=
